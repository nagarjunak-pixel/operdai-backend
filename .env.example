# Database
DATABASE_URL=postgresql+asyncpg://operdai:operdai_dev_password@localhost:5432/operdai
DATABASE_URL_SYNC=postgresql://operdai:operdai_dev_password@localhost:5432/operdai
# The app role is used for RLS-enforced connections
DATABASE_APP_ROLE=operdai_app

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_SUPERVISOR_MODEL=claude-opus-4-8
LLM_CRITIC_MODEL=claude-opus-4-8
LLM_WORKER_MODEL=claude-haiku-4-5

# Encryption (for OAuth tokens at rest)
ENCRYPTION_KEY=generate-a-fernet-key-here

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
